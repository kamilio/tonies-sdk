{
  "name": "@kamils-jamco/tonies-sdk",
  "version": "0.1.0",
  "description": "Toolcraft CLI, cloud SDK, and realtime Toniebox controls for Tonies",
  "repository": { "type": "git", "url": "git+https://github.com/kamilio/tonies-sdk.git" },
  "type": "module",
  "bin": {
    "tonies": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./root": {
      "types": "./dist/root.d.ts",
      "import": "./dist/root.js"
    },
    "./cloud": {
      "types": "./dist/cloud.d.ts",
      "import": "./dist/cloud.js"
    },
    "./realtime": {
      "types": "./dist/realtime.d.ts",
      "import": "./dist/realtime.js"
    }
  },
  "files": [
    "dist",
    "tests",
    "USAGE.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:memory": "npm run build && node --expose-gc tests/cloud-realtime.test.mjs && node --expose-gc tests/sync-plan.test.mjs"
  },
  "dependencies": {
    "classic-level": "^3.0.0",
    "dotenv": "^17.2.1",
    "mqtt": "^5.15.2",
    "music-metadata": "^11.13.0",
    "toolcraft": "^0.0.84",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
